# The `reverse_string` function takes a string as input and returns its reverse.
def reverse_string(s: str) -> str:
    """Return the reverse of the input string."""
    return s[::-1]

# This function checks if the input string can be converted to a float, which would indicate that it represents a number.


def is_number(s: str) -> bool:
    """Return True if s represents a number (int or float)."""
    try:
        float(s)
        return True
    except ValueError:
        return False


if __name__ == "__main__":
    while True:
        text = input("Enter a string to reverse: ").strip()
        if text == "":
            print("Please enter a non-empty string. Try again.")
            continue
        if is_number(text):
            print("Please enter a string, not a number. Try again.")
            continue
        print(reverse_string(text))
        break
